# Rendered media. Big, binary, and reproducible from the scripts in this repo
# (gameshots.py -> promo/shot-*.mp4, harvest_stills.py -> store/stills/).
# Git keeps every version of a binary forever, so ~140 MB of MP4s would bloat
# the clone permanently for something a re-render regenerates.
promo/
store/stills/
gallery/
shots/panels/
shots/workspace.png
gif/frames/

# build output
dist/
__pycache__/
*.pyc
.coverage

# run logs
e2e.log
*.log

# per-version gate output
versions.log
gui_versions.log
first_run.log
compare_run.log
pas_alone.log
gif/palette.png
_posters/
MARKETING.html
