+def gradient_level(x: int, y: int, x0: int, y0: int, x1: int, y1: int) -> int:
+    """Sixteenths of the END colour at (x, y), for a drag from (x0, y0) to (x1, y1).
+
+    The texel is projected onto the drag: 0 at or behind the start, 16 at or
+    past the end, rounded to the nearest step between. Integer arithmetic
+    throughout, so the same drag gives the same texels on every machine. A
+    zero-length drag has no direction and is level 0 everywhere.
+    """
+    dx, dy = x1 - x0, y1 - y0
+    d2 = dx * dx + dy * dy
+    if d2 == 0:
+        return 0
+    num = (x - x0) * dx + (y - y0) * dy
+    return max(0, min(16, (32 * num + d2) // (2 * d2)))
+
+
+def gradient_mask(w: int, h: int, x0: int, y0: int, x1: int, y1: int) -> bytearray:
+    """Which texels of a w x h canvas take the END colour of a dithered gradient.
+
+    One byte per texel, row-major, 1 for the end colour and 0 for the start
+    colour. Each texel is tested against BAYER4 at its `gradient_level`, on the
+    same canvas-fixed grid as the dither brush, so a gradient lines up with
+    dithered strokes laid over it and never blends a colour that is not one of
+    the two it was given.
+    """
+    out = bytearray(w * h)
+    dx, dy = x1 - x0, y1 - y0
+    d2 = dx * dx + dy * dy
+    if d2 == 0:
+        return out
+    for y in range(h):
+        cells = BAYER4[y % 4]
+        num = -x0 * dx + (y - y0) * dy
+        row = y * w
+        for x in range(w):
+            if cells[x % 4] < (32 * num + d2) // (2 * d2):
+                out[row + x] = 1
+            num += dx
+    return out
+
+
+def gradient_apply(px: bytearray, mask: bytearray, start: int | None,
+                   end: int | None, keep: bytearray | None = None) -> None:
+    """Write a gradient mask into a layer's index bytes, in place.
+
+    `start` and `end` are palette indices; None leaves those texels as they
+    are, which is how a colour fades into the art already there. `keep` is a
+    selection mask: texels outside it are never touched.
+    """
+    if keep is None and start is not None and end is not None:
+        px[:] = mask.translate(bytes((start, end)) + bytes(254))
+        return
+    for i, hit in enumerate(mask):
+        if keep is not None and not keep[i]:
+            continue
+        idx = end if hit else start
+        if idx is not None:
+            px[i] = idx
+
+
